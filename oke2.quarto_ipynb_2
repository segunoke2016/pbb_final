        "---\n",
        "title: \"GAPMINDER | LIFE EXPECTANCIES 2002\"  \n",
        "format: dashboard\n",
        "#execute:\n",
        " #  echo: false\n",
        "  #output: false\n",
        "---"
      ],
      "id": "bdcb35b3"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "import itables"
      ],
      "id": "cd618996",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Load the data\n",
        "gap = px.data.gapminder()\n",
        "\n",
        "# Filter for year 2002\n",
        "gap_02 = gap.query(\"year == 2002\")\n",
        "\n",
        "# Compute highest life expectancy\n",
        "avg_life = gap_02.groupby(\"year\")[\"lifeExp\"].mean().reset_index()\n",
        "fig_life_exp = px.line(\n",
        "    avg_life,\n",
        "    x=\"year\",\n",
        "    y=\"lifeExp\",\n",
        "    title=\"Average Life Expectancy Over Time\"\n",
        ")\n",
        "#fig.show()\n",
        "\n",
        "# Compute lowest life expectancy\n",
        "fig_gdp_lifexp = px.scatter(\n",
        "    gap_02[gap_02[\"year\"] == 2002],\n",
        "    x=\"gdpPercap\",\n",
        "    y=\"lifeExp\",\n",
        "    size=\"pop\",\n",
        "    color=\"continent\",\n",
        "    hover_name=\"country\",\n",
        "    log_x=True,\n",
        "    title=\"GDP vs Life Expectancy\"\n",
        ")\n",
        "#fig.show()\n",
        "\n",
        "# Create the map using plotly express with a blue color scale\n",
        "map_fig = px.choropleth(\n",
        "    gap_02[gap_02[\"year\"] == 2002],\n",
        "    locations=\"iso_alpha\",\n",
        "    color=\"lifeExp\",\n",
        "    hover_name=\"country\",\n",
        "    title=\"Global Life Expectancy Map\",\n",
        "    color_continuous_scale=\"Blues\",\n",
        ").update_layout(coloraxis_showscale=False)\n",
        "#fig.show()\n",
        "\n",
        "# Compute highest life expectancy\n",
        "highest_row = gap_02.sort_values(\"lifeExp\", ascending=False).head(1).squeeze()\n",
        "highest_life_exp_country = highest_row[\"country\"]\n",
        "highest_life_exp_value = round(highest_row[\"lifeExp\"], 1)\n",
        "\n",
        "# Compute lowest life expectancy\n",
        "lowest_row = gap_02.sort_values(\"lifeExp\", ascending=True).head(1).squeeze()\n",
        "lowest_life_exp_country = lowest_row[\"country\"]\n",
        "lowest_life_exp_value = round(lowest_row[\"lifeExp\"], 1)\n",
        "\n",
        "# Compute average (population-weighted) life expectancy\n",
        "weighted_mean = (gap_02[\"lifeExp\"] * gap_02[\"pop\"]).sum() / gap_02[\"pop\"].sum()\n",
        "average_life_exp_value = round(weighted_mean, 1)\n",
        "\n",
        "\n",
        "# Largest 20 countries by Life Expectancy (bar chart) with a blue color scale\n",
        "top_20 = gap_02.nlargest(20, \"pop\").sort_values(\"lifeExp\", ascending=True)\n",
        "bar_fig = px.bar(\n",
        "    top_20,\n",
        "    x=\"lifeExp\",\n",
        "    y=\"country\",\n",
        "    title=\"Life Expectancy in 20 Largest Countries\",\n",
        "    color=\"lifeExp\",\n",
        "    color_continuous_scale=\"Blues\",\n",
        ").update_layout(coloraxis_showscale=False)"
      ],
      "id": "93f67e95",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Create regional summary\n",
        "reg_sum = (\n",
        "    gap_02.groupby(\"continent\")\n",
        "    .apply(\n",
        "        lambda g: pd.Series(\n",
        "            {\n",
        "                \"Average Life Expectancy\": g[\"lifeExp\"].mean(),\n",
        "                \"Lowest Life Expectancy\": g[\"lifeExp\"].min(),\n",
        "                \"Country with Lowest Life Exp\": g.loc[g[\"lifeExp\"].idxmin(), \"country\"],\n",
        "                \"Highest Life Expectancy\": g[\"lifeExp\"].max(),\n",
        "                \"Country with Highest Life Exp\": g.loc[\n",
        "                    g[\"lifeExp\"].idxmax(), \"country\"\n",
        "                ],\n",
        "            }\n",
        "        )\n",
        "    )\n",
        "    .round(2)\n",
        ")\n"
      ],
      "id": "9ae46cf3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "continent_fig = px.box(\n",
        "    gap_02,\n",
        "    x=\"continent\",\n",
        "    y=\"lifeExp\",\n",
        "    color=\"continent\",\n",
        "    title=\"Distribution of Life Expectancy by Continent\",\n",
        "    points=\"all\",  # This shows all data points\n",
        "    hover_data=[\"country\"],  # This adds country names to hover info\n",
        "    color_discrete_sequence=px.colors.sequential.Turbo,  # Built-in Blues palette\n",
        ").update_layout(\n",
        "    showlegend=False, xaxis_title=\"Continent\", yaxis_title=\"Life Expectancy (years)\"\n",
        ")"
      ],
      "id": "b821f98b",
